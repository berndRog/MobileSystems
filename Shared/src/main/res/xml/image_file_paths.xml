<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
   <!-- The concrete image subdirectory is configurable, therefore the shared
        FileProvider exposes filesDir while ImageFileStorage still creates and
        validates files only inside its configured directory. -->
   <files-path
      name="app_images"
      path="." />
</paths>
